<?xml version="1.0" encoding="utf-8"?>
<!-- Command-center dashboard: fixed header + scrolling stack of MaterialCardView panels.
     Every value shown is bound to real broker state in MainActivity (no placeholder data). -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cc_bg">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/cc_header"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <View
            android:id="@+id/headerLed"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/cc_led"
            app:layout_constraintBottom_toBottomOf="@id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/title" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.08"
            android:tag="accent"
            android:text="@string/cc_title"
            android:textColor="@color/accent_cyan"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/refreshButton"
            app:layout_constraintStart_toEndOf="@id/headerLed"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/headerSubtitle"
            style="@style/CC.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/main_subtitle"
            app:layout_constraintEnd_toStartOf="@id/refreshButton"
            app:layout_constraintStart_toStartOf="@id/title"
            app:layout_constraintTop_toBottomOf="@id/title" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refreshButton"
            style="@style/CC.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:text="@string/refresh_scopes"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/header">

        <LinearLayout
            android:id="@+id/panelStack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="24dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelTalk"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleTalk"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_talk" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/talkButton"
                            style="@style/CC.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="2"
                            android:textSize="18sp"
                            android:text="@string/talk_start" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/talkStopButton"
                            style="@style/CC.Button"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:enabled="false"
                            android:text="@string/talk_stop" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/talkLed"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/cc_led"
                            android:backgroundTint="@color/led_off" />

                        <TextView
                            android:id="@+id/talkStatusText"
                            style="@style/CC.Caption"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/talk_idle" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/talkPartialText"
                        style="@style/CC.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="3"
                        android:text="" />

                    <TextView
                        android:id="@+id/talkHistoryText"
                        style="@style/CC.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="14"
                        android:textIsSelectable="true"
                        android:text="" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/talkVoiceButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/talk_voice_loading" />

                    <TextView
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/talk_note" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelScans"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleScans"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_scans" />

                    <TextView
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/scans_hint" />

                    <TextView
                        android:id="@+id/scanDetailText"
                        style="@style/CC.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="90"
                        android:textIsSelectable="true"
                        android:text="@string/scans_empty" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/scanList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanCopyButton"
                            style="@style/CC.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/scan_copy" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/scanClearButton"
                            style="@style/CC.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/scan_clear" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/scanRepairButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repair_datawedge" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelSystems"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleSystems"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_systems" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/statusList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelMesh"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleMesh"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_mesh" />

                    <TextView
                        android:id="@+id/meshProbeText"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:text="@string/mesh_not_probed" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/bridgeList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/probeBridgesButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/probe_bridges" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelConnections"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleConnections"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_connections" />

                    <TextView
                        android:id="@+id/connectionsHint"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:text="@string/connections_hint" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/connectionList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelSecurity"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleSecurity"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_security" />

                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mcp_token_label" />
                    <TextView
                        android:id="@+id/mcpTokenText"
                        style="@style/CC.Mono"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/cc_input_bg"
                        android:padding="10dp"
                        android:text="@string/mcp_token_hidden"
                        android:textIsSelectable="true" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/mcpTokenButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/reveal_mcp_token" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/rotateTokenButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/rotate_mcp_token" />
                    <TextView
                        android:id="@+id/securityNote"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:text="@string/security_note" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelControls"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleControls"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_controls" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/shizukuPermissionButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/request_shizuku" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/dhizukuButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/connect_dhizuku" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/a11yButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/open_accessibility" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/batteryButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/battery_exemption" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/datawedgeButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/query_datawedge" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/repairDataWedgeButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/repair_datawedge" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/roamHardenButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/roam_harden" />
                    <TextView
                        android:id="@+id/datawedgeStatusText"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:maxLines="6"
                        android:ellipsize="end"
                        android:text="@string/datawedge_none" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelSettings"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleSettings"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_settings" />

                    <TextView
                        android:id="@+id/settingsNote"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:text="@string/settings_note" />
                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/mesh_base_label" />
                    <EditText
                        android:id="@+id/meshBaseInput"
                        style="@style/CC.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/mesh_base_hint"
                        android:inputType="textUri" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveMeshBaseButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_mesh_base" />
                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/upstream_url_label" />
                    <EditText
                        android:id="@+id/upstreamUrlInput"
                        style="@style/CC.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/upstream_url_hint"
                        android:inputType="textUri" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveUpstreamButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_upstream" />
                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bridge_urls_label" />
                    <EditText
                        android:id="@+id/bridgeUrlsInput"
                        style="@style/CC.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/bridge_urls_hint"
                        android:inputType="textUri|textMultiLine" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveBridgesButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_bridges" />
                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/airtable_key_label" />
                    <EditText
                        android:id="@+id/airtableKeyInput"
                        style="@style/CC.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/airtable_key_hint"
                        android:inputType="textPassword" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/saveAirtableButton"
                        style="@style/CC.Button"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/save_airtable" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/panelScopes"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleScopes"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/scopes_label" />

                    <TextView
                        android:id="@+id/scopesText"
                        style="@style/CC.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textIsSelectable="true"
                        android:text="@string/no_scopes" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            
<com.google.android.material.card.MaterialCardView
                android:id="@+id/panelCustomize"
                style="@style/CC.Panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/titleCustomize"
                        style="@style/CC.PanelTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:tag="accent"
                        android:text="@string/panel_customize" />

                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/customize_panels" />
                    <LinearLayout
                        android:id="@+id/panelToggleContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                    <TextView
                        style="@style/CC.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/customize_accent" />
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/accentGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        app:singleSelection="true"
                        app:selectionRequired="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
