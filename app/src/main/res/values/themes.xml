<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark command-center theme. Accent is applied at runtime from the user's choice. -->
    <style name="Theme.ShizukuAiBroker" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent_cyan</item>
        <item name="colorPrimaryVariant">@color/cc_header</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/accent_cyan</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/cc_bg</item>
        <item name="android:windowBackground">@color/cc_bg</item>
        <item name="colorSurface">@color/cc_panel</item>
        <item name="colorOnSurface">@color/cc_text</item>
        <item name="android:textColorPrimary">@color/cc_text</item>
        <item name="android:textColorSecondary">@color/cc_text_dim</item>
        <item name="android:statusBarColor">@color/cc_header</item>
        <item name="android:navigationBarColor">@color/cc_bg</item>
    </style>

    <style name="CC" />

    <style name="CC.Panel" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cc_panel</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/cc_panel_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="contentPadding">14dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="CC.PanelTitle">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>

    <style name="CC.Mono">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/cc_text</item>
    </style>

    <style name="CC.Caption">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cc_text_dim</item>
    </style>

    <style name="CC.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent_cyan</item>
        <item name="strokeColor">@color/accent_cyan</item>
        <item name="android:layout_marginTop">6dp</item>
    </style>

    <style name="CC.Input">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cc_text</item>
        <item name="android:textColorHint">@color/cc_text_dim</item>
        <item name="android:background">@drawable/cc_input_bg</item>
        <item name="android:padding">10dp</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="CC.Label">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/cc_text_dim</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>
</resources>
