{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shizuku AI Action Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "reason",
    "userVisibleSummary",
    "params"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "tap",
        "swipe",
        "text",
        "key",
        "ui_dump",
        "uidump",
        "snapshot",
        "shell",
        "admin_scopes",
        "scopes",
        "admin_perm",
        "perm",
        "admin_suspend",
        "suspend",
        "launch",
        "datawedge_status",
        "datawedge_version",
        "datawedge_profiles",
        "datawedge_active_profile",
        "datawedge_soft_scan",
        "datawedge_switch_profile",
        "datawedge_create_profile",
        "datawedge_set_config",
        "datawedge_last",
        "datawedge_query",
        "datawedge_results",
        "GET_DEVICE_INFO",
        "GET_PACKAGE_LIST",
        "GET_CURRENT_APP",
        "OPEN_APP",
        "OPEN_SETTINGS",
        "GET_BATTERY_INFO",
        "GET_DISPLAY_INFO"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "userVisibleSummary": {
      "type": "string",
      "minLength": 1
    },
    "params": {
      "type": "object"
    }
  }
}
